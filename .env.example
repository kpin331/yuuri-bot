# Salin file ini menjadi .env, atau jalankan `npm run setup` untuk membuatnya
# secara interaktif (akan meminta token bot, ID pemilik, dan metode login WhatsApp).
BOT_TOKEN=123456789:replace_me_with_your_token

# ID Telegram Anda (pemilik). Cari tahu melalui bot seperti @userinfobot.
# Digunakan untuk membatasi perintah khusus pemilik.
OWNER_ID=

# Pengaturan akses:
#   true  -> siapa saja dapat menggunakan bot
#   false -> hanya OWNER_ID dan ADMIN_IDS yang dapat menggunakan bot
EVERYONE=true

# Opsional: admin tepercaya tambahan (ID Telegram numerik, dipisahkan koma).
# Admin dapat memblokir/membuka blokir pengguna serta mengaktifkan/menonaktifkan
# perintah. Username tidak dianggap tepercaya. Cari ID melalui bot seperti @userinfobot.
# ADMIN_IDS=111111111,222222222

# Token refresh Pixiv (untuk /pixiv). Dapatkan dengan:
#   gallery-dl oauth:pixiv   (atau alat OAuth Pixiv lainnya)
# PIXIV_REFRESH_TOKEN=

# Opsional: lokasi penyimpanan basis data SQLite (statistik, status perintah, blokir).
# Bawaan: ./data/bot.db
# BOT_DB_PATH=

# Batas unggah/unduh aplikasi dalam MB (bawaan: 200).
# CATATAN: Telegram Bot API resmi menolak unggahan di atas 50 MB. File yang lebih
# besar hanya dapat dikirim jika menggunakan server Bot API lokal.
# MAX_UPLOAD_MB=200

# Opsional: ubah lokasi alat jika tidak tersedia melalui PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# GALLERYDL_PATH=gallery-dl

# Opsional: font untuk teks meme (/smeme). Bawaan menggunakan font sistem pertama
# yang ditemukan (Impact, Arial Bold, DejaVu Sans Bold). Harus berupa file .ttf atau .otf.
# MEME_FONT_PATH=C:\Windows\Fonts\impact.ttf

# Opsional: file cookie (format Netscape) untuk unduhan yang dibatasi usia/privat.
# YTDLP_COOKIES=C:\path\to\cookies.txt
# GALLERYDL_COOKIES=C:\path\to\cookies.txt

# Sidik jari peramban yang ditiru yt-dlp untuk melewati pemeriksaan bot/403.
# (memerlukan curl_cffi). Target apa pun dari `yt-dlp --list-impersonate-targets`,
# misalnya chrome, firefox, safari, chrome:windows-10. Bawaan: "chrome";
# atur ke "none" untuk menonaktifkan. (gallery-dl tidak mendukung peniruan ini.)
# YTDLP_IMPERSONATE=chrome

# === WhatsApp (platform kedua, opsional) ===
# Bot menjalankan WhatsApp bersama Telegram jika OWNER_NUMBER diisi.
# Format internasional, angka saja (tanpa "+", spasi, atau tanda hubung). Nomor ini
# adalah nomor pemilik WhatsApp dan juga dapat menjadi admin grup.
# OWNER_NUMBER=6281234567890

# Opsional: nomor pemilik tambahan jika ada beberapa (angka dipisahkan koma,
# format sama). Nomor duplikat dengan OWNER_NUMBER akan dihapus.
# OWNER_NUMBERS=6281234567890,6289876543210

# Opsional: admin WhatsApp tambahan (angka dipisahkan koma).
# ADMIN_NUMBERS=6281111111111,6282222222222

# Opsional: masuk dengan kode penautan, bukan memindai kode QR. Isi dengan nomor
# WhatsApp yang ingin ditautkan; kode akan ditampilkan saat bot dijalankan.
# PAIRING_NUMBER=6281234567890

# Opsional: lokasi penyimpanan sesi WhatsApp (bawaan ./auth). Tambahkan ke
# .gitignore. Hapus folder ini untuk melakukan login baru.
# WA_AUTH_DIR=auth

# Opsional: awalan perintah (bawaan ".") dan batas anti-penyalahgunaan.
# COMMAND_PREFIX=.
# DEFAULT_QUOTA=25
# ADMIN_QUOTA=30
# RATE_LIMIT=3
# RATE_WINDOW_SECONDS=60
# TIMEZONE=Asia/Jakarta

# Opsional: tingkat log Baileys (bawaan "silent"; coba "info" untuk menelusuri masalah).
# WA_LOG_LEVEL=silent

# === XP dan peringkat grup ===
# String koneksi PostgreSQL untuk XP dan peringkat grup.
# Bot membuat tabel XP saat dijalankan.
# POSTGRES_URL=postgresql://user:password@localhost:5432/yuuri

# Opsional: akses grup. Jika GROUP_ONLY=true, anggota hanya dapat menggunakan
# bot di grup yang tercantum dalam ALLOWED_GROUPS; jika false (bawaan), semua grup
# diizinkan. Pemilik dan admin (berdasarkan nomor) tidak dibatasi. Jalankan
# .userinfo di dalam grup untuk melihat ID-nya.
# GROUP_ONLY=false
# ALLOWED_GROUPS=120363012345678901@g.us,120363098765432109@g.us

# === Tautan pemutar (/play dan .play) ===
# Opsional: kredensial aplikasi Spotify. Jika keduanya diisi, bot mengambil judul
# DAN artis trek dari Spotify Web API (hasil terbaik). Jika tidak, bot menggunakan
# oEmbed yang hanya menyediakan judul. Buat aplikasi di:
#   https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Opsional: tolak trek yang lebih panjang dari jumlah menit ini (bawaan: 10).
# MAX_DURATION_MINUTES=10
