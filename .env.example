# Copy this file to .env and fill in your token from @BotFather.
BOT_TOKEN=123456789:replace_me_with_your_token

# Your Telegram user ID (owner). Get it from a helper bot like @userinfobot.
# Used to gate owner-only commands.
OWNER_ID=

# Access switch:
#   true  -> anyone can use the bot
#   false -> only OWNER_ID and ADMIN_IDS can use the bot
EVERYONE=true

# Optional: additional trusted admins (comma-separated numeric Telegram IDs).
# Admins can ban/unban users and enable/disable commands. Usernames are never
# trusted. Get IDs from a helper bot like @userinfobot.
# ADMIN_IDS=111111111,222222222

# Pixiv refresh token (for /pixiv). Get one with:
#   gallery-dl oauth:pixiv   (or any Pixiv OAuth tool)
# PIXIV_REFRESH_TOKEN=

# Optional: where the SQLite database (statistics, command states, bans) is stored.
# Defaults to ./data/bot.db
# BOT_DB_PATH=

# Application upload/download limit in MB (default 200).
# NOTE: the official Telegram cloud Bot API rejects uploads over 50 MB. Files
# larger than 50 MB can only be sent when running against a local Bot API server.
# MAX_UPLOAD_MB=200

# Optional: override tool paths if they are not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# GALLERYDL_PATH=gallery-dl

# Optional: cookie files (Netscape format) for age-restricted/private downloads.
# YTDLP_COOKIES=C:\path\to\cookies.txt
# GALLERYDL_COOKIES=C:\path\to\cookies.txt

# === WhatsApp (optional second platform) ===
# The bot runs WhatsApp alongside Telegram when OWNER_NUMBER is set.
# International format, digits only (no "+", spaces or dashes). This number is
# the WhatsApp owner and can also be a group admin.
# OWNER_NUMBER=6281234567890

# Optional: extra WhatsApp admins (comma-separated digits).
# ADMIN_NUMBERS=6281111111111,6282222222222

# Optional: log in with a pairing code instead of scanning a QR code. Set this
# to the WhatsApp number you want to link; the code is printed on startup.
# PAIRING_NUMBER=6281234567890

# Optional: where the WhatsApp session is stored (default ./auth). Add it to
# .gitignore. Delete it to force a fresh login.
# WA_AUTH_DIR=auth

# Optional: command prefix (default "."), and anti-abuse limits.
# COMMAND_PREFIX=.
# DEFAULT_QUOTA=15
# ADMIN_QUOTA=30
# RATE_LIMIT=3
# RATE_WINDOW_SECONDS=60
# TIMEZONE=Asia/Jakarta

# Optional: Baileys log level ("silent" by default; try "info" to debug).
# WA_LOG_LEVEL=silent
