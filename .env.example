# Copy this file to .env and fill in your token from @BotFather.
BOT_TOKEN=123456789:replace_me_with_your_token

# Your Telegram user ID (owner). Get it from a helper bot like @userinfobot.
# Used to gate owner-only commands.
OWNER_ID=

# Access switch:
#   true  -> anyone can use the bot
#   false -> only OWNER_ID can use the bot
EVERYONE=true

# Pixiv refresh token (for /pixiv). Get one with:
#   gallery-dl oauth:pixiv   (or any Pixiv OAuth tool)
# PIXIV_REFRESH_TOKEN=

# Optional: where the SQLite database (user statistics) is stored.
# Defaults to ./data/bot.db
# BOT_DB_PATH=

# Optional: override tool paths if they are not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# GALLERYDL_PATH=gallery-dl

# Optional: cookie files (Netscape format) for age-restricted/private downloads.
# YTDLP_COOKIES=C:\path\to\cookies.txt
# GALLERYDL_COOKIES=C:\path\to\cookies.txt
