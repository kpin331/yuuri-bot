# Copy this file to .env and fill in your token from @BotFather.
BOT_TOKEN=123456789:replace_me_with_your_token

# Optional: override tool paths if they are not on PATH.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# GALLERYDL_PATH=gallery-dl

# Optional: cookie files (Netscape format) for age-restricted/private downloads.
# YTDLP_COOKIES=C:\path\to\cookies.txt
# GALLERYDL_COOKIES=C:\path\to\cookies.txt
